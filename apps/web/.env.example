# Copy to .env and adjust as needed. Never commit .env.

# Base URL of the AssetFlow API as seen by the browser
VITE_API_BASE_URL=http://localhost:4000

# Target the dev server proxies /api/* requests to (default http://localhost:4000).
# In docker compose this is set to http://api:4000.
API_PROXY_TARGET=http://localhost:4000

# Optional: point the browser straight at the API instead of using the proxy.
# When unset, requests are same-origin and go through the Vite dev proxy.
# VITE_API_BASE_URL=http://localhost:4000
