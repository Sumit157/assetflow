# Copy to .env and adjust as needed. Never commit .env.

# Runtime environment: development | test | production
NODE_ENV=development

# HTTP port for the API
PORT=4000

# MongoDB connection (local default matches docker-compose.yml; host port
# 27018 avoids clashing with a locally installed MongoDB)
MONGODB_URI=mongodb://localhost:27018/assetflow

# Redis connection (local default matches docker-compose.yml)
REDIS_URL=redis://localhost:6379

# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=http://localhost:5175

# Log verbosity: debug | info | warn | error | silent
LOG_LEVEL=debug

# Sliding window rate limit for /api/v1 requests
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Reverse-proxy hops to trust for real client IPs (0 = disabled).
# Set to 1 when running behind a proxy/ALB.
TRUST_PROXY_HOPS=0

# Web app origin used in emailed links (verification, reset, invitations)
WEB_URL=http://localhost:5175

# Secret used to sign short-lived access tokens (min 32 chars).
# Required in production; development falls back to a well-known value.
JWT_SECRET=change-me-to-a-long-random-string

# Access token lifetime in seconds (default 15 minutes)
ACCESS_TOKEN_TTL_SECONDS=900

# Refresh session lifetime in days (sliding, cookie-backed)
REFRESH_TOKEN_TTL_DAYS=30

# Stricter rate limit for authentication endpoints
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=15

# Email delivery: log (writes messages to the log; the only value for now)
EMAIL_TRANSPORT=log
